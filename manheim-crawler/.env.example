# 目标拍卖
AUCTION_ID=ND060726
FRANCHISE_ID=SALVAGENZ

# 抓取节流（抗封）
MAX_CONCURRENCY=4
MIN_DELAY_MS=500
MAX_RETRIES=5

# 存储
DB_PATH=./data/manheim.sqlite

# 可选代理（本地默认关，留空即不用）
PROXY_URL=

# S3（可开关；ENABLED=false 时跳过图片上传但不阻断数据抓取）
S3_ENABLED=false
S3_BUCKET=
S3_REGION=
S3_PREFIX=manheim/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# MySQL 写回（预留，默认关）
MYSQL_SYNC=false
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
